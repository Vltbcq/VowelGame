const ACCENTS := {
	"acute": "...#.|..#..",
	"grave": ".#...|..#..",
	"circ": "..#..|.#.#.",
	"diaer": ".....|.#.#.",
	"cedil": "..#..|.##..",
}

const COMPOSED := {
	"É": ["E", "acute"], "È": ["E", "grave"], "Ê": ["E", "circ"], "Ë": ["E", "diaer"],
	"À": ["A", "grave"], "Â": ["A", "circ"], "Î": ["I", "circ"], "Ï": ["I", "diaer"],
	"Ô": ["O", "circ"], "Ù": ["U", "grave"], "Û": ["U", "circ"], "Ü": ["U", "diaer"],
	"Ç": ["C", "cedil"],
}


static func _grid(body: String) -> Array:
	var rows := []
	for i in H:
		rows.append(".....")
	var parts := body.split("|")
	for i in parts.size():
		if 2 + i < H:
			rows[2 + i] = parts[i].rpad(5, ".")
	return rows


static func build() -> FontFile:
	var cells := {}
	for k in GLYPHS:
		cells[k] = _grid(GLYPHS[k])
	for k in COMPOSED:
		var base: Array = (cells[COMPOSED[k][0]] as Array).duplicate()
		var acc: PackedStringArray = ACCENTS[COMPOSED[k][1]].split("|")
		if COMPOSED[k][1] == "cedil":
			base[9] = acc[0]
			base[10] = acc[1]
		else:
			base[0] = acc[0]
			base[1] = acc[1]
		cells[k] = base
	# Minuscules -> même dessin que les majuscules
	var all := {}
	for k: String in cells:
		all[k.unicode_at(0)] = cells[k]
		var low := k.to_lower()
		if low != k:
			all[low.unicode_at(0)] = cells[k]
	all[" ".unicode_at(0)] = _grid("")
	all["’".unicode_at(0)] = cells["'"]
	all["œ".unicode_at(0)] = cells["Œ"]

	var entries := []
	var total := 1
	for cp in all:
		var g: Array = all[cp]
		var x0 := 5
		var x1 := -1
		for row: String in g:
			for x in 5:
				if row[x] == "#":
					x0 = mini(x0, x)
					x1 = maxi(x1, x)
		var w := 0 if x1 < 0 else x1 - x0 + 1
		entries.append([cp, g, x0, w])
		total += w + 1

	var img := Image.create_empty(total, H, false, Image.FORMAT_RGBA8)
	var f := FontFile.new()
	# Ces propriétés vident le cache des glyphes : à régler AVANT de les ajouter.
	f.fixed_size = SIZE
	f.fixed_size_scale_mode = TextServer.FIXED_SIZE_SCALE_INTEGER_ONLY
	f.antialiasing = TextServer.FONT_ANTIALIASING_NONE
	f.generate_mipmaps = false
	f.allow_system_fallback = true
	var sz := Vector2i(SIZE, 0)
	var cx := 1
	for e in entries:
		var cp: int = e[0]
		var g: Array = e[1]
		var x0: int = e[2]
		var w: int = e[3]
		for y in H:
			var row: String = g[y]
			for x in w:
				if row[x0 + x] == "#":
					img.set_pixel(cx + x, y, Color.WHITE)
		f.set_glyph_advance(0, SIZE, cp, Vector2(w + 1 if w > 0 else 4, 0))
		f.set_glyph_offset(0, sz, cp, Vector2(0, -ASCENT))
		f.set_glyph_size(0, sz, cp, Vector2(w, H))
		f.set_glyph_uv_rect(0, sz, cp, Rect2(cx, 0, w, H))
		f.set_glyph_texture_idx(0, sz, cp, 0)
		cx += w + 1
	f.set_texture_image(0, sz, 0, img)
	f.set_cache_ascent(0, SIZE, ASCENT)
	f.set_cache_descent(0, SIZE, H - ASCENT)
	return f
